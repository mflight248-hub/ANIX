# Ignore executable binaries
*.exe

# Ignore MSVC compiler build artifacts
*.obj
*.ilk
*.pdb
vc140.pdb

# Ignore the build output folder
build/

# Ignore temporary code runner files
tempCodeRunnerFile.*

