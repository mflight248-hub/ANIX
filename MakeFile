CC = gcc
LD = gcc
AS = nasm

KERNEL = mykernel.bin

SRCDIR = src
OBJDIR = obj

CFLAGS = -m32 -ffreestanding -O2 -Wall -Wextra -Isrc -Isrc/drivers -fno-builtin
LDFLAGS = -m32 -T linker.ld -nostdlib

SRCS_C := $(shell find $(SRCDIR) -name '*.c')
SRCS_ASM := $(shell find arch -name '*.asm')

OBJS := $(patsubst $(SRCDIR)/%.c,$(OBJDIR)/%.o,$(SRCS_C)) \
        $(patsubst arch/%.asm,$(OBJDIR)/arch/%.o,$(SRCS_ASM))

.PHONY: all clean

all: $(KERNEL)

$(KERNEL): $(OBJS)
	$(LD) $(LDFLAGS) -o $@ $^

# C compilation
$(OBJDIR)/%.o: $(SRCDIR)/%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# NASM compilation
$(OBJDIR)/arch/%.o: arch/%.asm
	mkdir -p $(dir $@)
	$(AS) -f elf32 $< -o $@

clean:
	rm -rf $(OBJDIR) $(KERNEL)
